diff --git b/tests/Feature/FleetPresenceTest.php b/tests/Feature/FleetPresenceTest.php
new file mode 100644
index 0000000..9d07765
--- /dev/null
+++ b/tests/Feature/FleetPresenceTest.php
@@ -0,0 +1,296 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Jobs\ProcessMachineMessage;
+use App\Jobs\RecordStartAck;
+use App\Jobs\SendMqttCommand;
+use App\Models\DeviceOutlet;
+use App\Models\DeviceTransaction;
+use App\Services\MachineMessageHandler;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Queue;
+use Illuminate\Support\Facades\Redis;
+
+/**
+ * F5 watchdog, F6 presence + start reconciliation, F8 ingest, F13 status column.
+ * Fixture (PaymentTestCase): device TESTSN0001 at an outlet, pulse_price RM1.
+ */
+class FleetPresenceTest extends PaymentTestCase
+{
+    private MachineMessageHandler $h;
+    private string $sn = 'TESTSN0001';
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+        $this->h = app(MachineMessageHandler::class);
+        $this->resetRedis();
+        config(['services.telegram.bot_token' => 'T', 'services.telegram.admin_chat_id' => '1']);
+        Http::fake(['api.telegram.org/*' => Http::response(['ok' => true])]);
+    }
+
+    protected function tearDown(): void
+    {
+        $this->resetRedis();
+        parent::tearDown();
+    }
+
+    private function resetRedis(): void
+    {
+        Redis::del(DeviceOutlet::presenceKey($this->sn), "machine:last_payload:{$this->sn}");
+        Redis::hdel(MachineMessageHandler::HEARTBEATS, $this->sn);
+        Redis::zrem(MachineMessageHandler::LAST_SEEN, $this->sn);
+    }
+
+    private function telemetry(array $p, bool $retained = false): string
+    {
+        return $this->h->handle("machines/{$this->sn}/telemetry", json_encode($p), $retained);
+    }
+
+    private function outlet(): DeviceOutlet
+    {
+        return DeviceOutlet::where('device_serial_number', $this->sn)->first();
+    }
+
+    // ───────────── F8: ingest ─────────────
+
+    public function test_plain_heartbeats_create_no_jobs_after_the_first(): void
+    {
+        $this->assertSame('came_online', $this->telemetry(['status' => 'online', 'coins' => 0]));
+        $this->assertSame('heartbeat', $this->telemetry(['status' => 'online', 'coins' => 0]));
+        $this->assertSame('heartbeat', $this->telemetry(['status' => 'online', 'coins' => 0]));
+
+        Queue::assertPushed(ProcessMachineMessage::class, 1);
+        $this->assertTrue($this->outlet()->is_online);
+        $this->assertNotFalse(Redis::zscore(MachineMessageHandler::LAST_SEEN, $this->sn));
+        $this->assertSame((int) config('lbpay.presence_ttl_seconds'), Redis::ttl(DeviceOutlet::presenceKey($this->sn)));
+    }
+
+    public function test_empty_retained_delete_is_ignored_quietly(): void
+    {
+        $this->assertSame('ignored_empty', $this->h->handle("machines/{$this->sn}/telemetry", '', true));
+        $this->assertSame('ignored_empty', $this->h->handle("machines/{$this->sn}/telemetry", ''));
+        Queue::assertNothingPushed();
+    }
+
+    public function test_coin_message_queues_a_job_with_the_coins(): void
+    {
+        $this->telemetry(['status' => 'online', 'coins' => 0]);
+        $this->assertSame('coins', $this->telemetry(['status' => 'online', 'coins' => 1]));
+
+        Queue::assertPushed(ProcessMachineMessage::class, fn ($j) => $j->payload['coins'] === 1);
+    }
+
+    public function test_retained_old_lwt_on_telemetry_is_ignored(): void
+    {
+        $this->telemetry(['status' => 'online']);
+        $this->assertSame('ignored_retained', $this->telemetry(['status' => 'offline'], retained: true));
+        $this->assertTrue($this->outlet()->is_online);
+    }
+
+    public function test_live_offline_message_makes_device_not_payable(): void
+    {
+        $this->telemetry(['status' => 'online']);
+        $this->assertSame('went_offline', $this->telemetry(['status' => 'offline']));
+
+        // F6: used to stay "online" for 10 minutes because the key existed.
+        $this->assertFalse($this->outlet()->is_online);
+        Queue::assertPushed(ProcessMachineMessage::class, fn ($j) => $j->payload['status'] === 'offline');
+    }
+
+    public function test_presence_topic_online_and_offline(): void
+    {
+        $this->assertSame('came_online', $this->h->handle("machines/{$this->sn}/presence", '{"status":"online"}', true));
+        $this->assertTrue($this->outlet()->is_online);
+        $this->assertSame('went_offline', $this->h->handle("machines/{$this->sn}/presence", '{"status":"offline"}', true));
+        $this->assertFalse($this->outlet()->is_online);
+    }
+
+    public function test_boot_event_records_version_and_reboot(): void
+    {
+        $this->assertSame('boot', $this->h->handle("machines/{$this->sn}/status", '{"event":"boot","status":"online","version":"1.5.6"}'));
+
+        Queue::assertPushed(ProcessMachineMessage::class, fn ($j) => ($j->payload['event'] ?? null) === 'boot');
+        (new ProcessMachineMessage($this->sn, ['status' => 'online', 'event' => 'boot', 'version' => '1.5.6']))->handle();
+
+        $this->assertSame('1.5.6', DB::table('devices')->where('serial_number', $this->sn)->value('version'));
+        $this->assertNotNull(DB::table('device_has_outlet')->where('device_serial_number', $this->sn)->value('last_reboot_at'));
+    }
+
+    public function test_unknown_status_message_no_longer_wipes_ota_status(): void
+    {
+        DB::table('devices')->where('serial_number', $this->sn)->update(['ota_status' => 'success']);
+        $this->assertSame('ignored_status', $this->h->handle("machines/{$this->sn}/status", '{"something":"else"}'));
+        $this->assertSame('success', DB::table('devices')->where('serial_number', $this->sn)->value('ota_status'));
+    }
+
+    // ───────────── F13: status column ─────────────
+
+    public function test_legacy_capitalised_status_does_not_cause_a_db_write_per_heartbeat(): void
+    {
+        DB::table('device_has_outlet')->where('device_serial_number', $this->sn)->update(['status' => 'Online', 'updated_at' => '2026-01-01 00:00:00']);
+
+        (new ProcessMachineMessage($this->sn, ['status' => 'online', 'coins' => 0]))->handle();
+
+        $this->assertSame('2026-01-01 00:00:00', DB::table('device_has_outlet')->where('device_serial_number', $this->sn)->value('updated_at'));
+    }
+
+    public function test_status_column_accepts_rebooting_and_faulty_is_never_overwritten(): void
+    {
+        DB::table('device_has_outlet')->where('device_serial_number', $this->sn)->update(['status' => 'faulty']);
+
+        (new ProcessMachineMessage($this->sn, ['status' => 'online', 'coins' => 2]))->handle();
+
+        $row = DB::table('device_has_outlet')->where('device_serial_number', $this->sn)->first();
+        $this->assertSame('faulty', $row->status);     // maintenance flag kept
+        $this->assertEquals(2, $row->current_coins);    // coins still counted
+
+        DB::table('device_has_outlet')->where('device_serial_number', $this->sn)->update(['status' => 'rebooting']); // was invalid for the enum
+        $this->assertSame('rebooting', $this->outlet()->status);
+    }
+
+    // ───────────── F5: watchdog ─────────────
+
+    public function test_watchdog_does_not_flap_a_device_that_keeps_sending_heartbeats(): void
+    {
+        DB::table('device_has_outlet')->update(['status' => 'online', 'last_seen_at' => now()->subHour()]); // old DB value
+        $this->telemetry(['status' => 'online']); // fresh heartbeat in Redis
+
+        $this->artisan('app:machine-watchdog')->assertSuccessful();
+
+        $this->assertSame('online', $this->outlet()->status);
+        Http::assertNothingSent();
+    }
+
+    public function test_watchdog_marks_silent_device_offline_and_alerts_once(): void
+    {
+        DB::table('device_has_outlet')->update(['status' => 'online']);
+        $this->telemetry(['status' => 'online']);
+        Redis::zadd(MachineMessageHandler::LAST_SEEN, now()->subMinutes(10)->timestamp, $this->sn);
+
+        $this->artisan('app:machine-watchdog')->assertSuccessful();
+        $this->artisan('app:machine-watchdog')->assertSuccessful();
+
+        $this->assertSame('offline', $this->outlet()->status);
+        $this->assertFalse($this->outlet()->is_online);
+        Http::assertSentCount(1);
+        Http::assertSent(fn ($r) => str_contains($r['text'], 'TESTSN0001') && str_contains($r['text'], 'Outlet 1'));
+    }
+
+    // ───────────── F6: paid-start tracking & reconciliation ─────────────
+
+    private function activatedStart(int $startedSecondsAgo, array $meta = []): DeviceTransaction
+    {
+        $txn = DeviceTransaction::create([
+            'customer_id' => $this->customer->id, 'device_outlet_id' => $this->deviceOutletId,
+            'amount' => '5.00', 'currency' => 'MYR', 'status' => 'paid', 'provider' => 'ewallet',
+            'order_id' => 'ORD-W-' . uniqid(), 'meta' => ['mode' => 'washer_cold'],
+        ]);
+        app(\App\Services\MachineStartService::class)->dispatchForTransaction($txn);
+        $txn->refresh();
+        $txn->update(['meta' => array_merge($txn->meta, ['started_at' => now()->subSeconds($startedSecondsAgo)->toIso8601String()], $meta)]);
+        return $txn->fresh();
+    }
+
+    public function test_device_acks_are_recorded_on_the_transaction(): void
+    {
+        $txn = $this->activatedStart(5);
+        $op = $txn->meta['op_id'];
+
+        $this->h->handle("machines/{$this->sn}/status", json_encode(['event' => 'start_ack', 'op_id' => $op, 'status' => 'received', 'pulses' => 5]));
+        $this->h->handle("machines/{$this->sn}/status", json_encode(['event' => 'start_ack', 'op_id' => $op, 'status' => 'completed', 'pulses' => 5, 'sent' => 5]));
+
+        Queue::assertPushed(RecordStartAck::class, 2);
+        (new RecordStartAck($txn->id, ['op_id' => $op, 'status' => 'received']))->handle();
+        (new RecordStartAck($txn->id, ['op_id' => $op, 'status' => 'completed', 'sent' => 5]))->handle();
+
+        $txn->refresh();
+        $this->assertSame('completed', $txn->status);
+        $this->assertSame(5, $txn->meta['pulses_sent']);
+        $this->assertNotEmpty($txn->meta['ack_received_at']);
+    }
+
+    public function test_rejected_start_goes_to_review(): void
+    {
+        $txn = $this->activatedStart(5);
+        (new RecordStartAck($txn->id, ['op_id' => $txn->meta['op_id'], 'status' => 'rejected', 'error' => 'too_many_pulses:max=100']))->handle();
+
+        $txn->refresh();
+        $this->assertSame('review', $txn->status);
+        $this->assertSame('too_many_pulses:max=100', $txn->meta['ack_error']);
+    }
+
+    public function test_unacknowledged_start_is_resent_once_with_the_same_op_id(): void
+    {
+        DB::table('devices')->where('serial_number', $this->sn)->update(['version' => '1.5.6']);
+        $this->telemetry(['status' => 'online']);
+        $txn = $this->activatedStart(120);
+        $op = $txn->meta['op_id'];
+
+        $this->artisan('app:reconcile-starts')->assertSuccessful();
+        $this->artisan('app:reconcile-starts')->assertSuccessful();
+
+        // 1 original + exactly 1 retry, both with the same op_id.
+        Queue::assertPushed(SendMqttCommand::class, 2);
+        Queue::assertPushed(SendMqttCommand::class, fn ($j) => $j->payload['op_id'] === $op);
+        Queue::assertNotPushed(SendMqttCommand::class, fn ($j) => $j->payload['op_id'] !== $op);
+        $this->assertSame(1, $txn->fresh()->meta['retry_count']);
+    }
+
+    public function test_older_firmware_is_never_auto_resent(): void
+    {
+        DB::table('devices')->where('serial_number', $this->sn)->update(['version' => '1.5.5']);
+        $this->telemetry(['status' => 'online']);
+        $this->activatedStart(120);
+
+        $this->artisan('app:reconcile-starts')->assertSuccessful();
+
+        Queue::assertPushed(SendMqttCommand::class, 1); // only the original — goes to review later instead
+    }
+
+    public function test_received_start_is_never_auto_resent(): void
+    {
+        DB::table('devices')->where('serial_number', $this->sn)->update(['version' => '1.5.6']);
+        $this->telemetry(['status' => 'online']);
+        $this->activatedStart(120, ['ack_received_at' => now()->toIso8601String()]);
+
+        $this->artisan('app:reconcile-starts')->assertSuccessful();
+
+        Queue::assertPushed(SendMqttCommand::class, 1); // only the original
+    }
+
+    public function test_stuck_start_is_flagged_for_review_and_reported(): void
+    {
+        $txn = $this->activatedStart(700);
+
+        $this->artisan('app:reconcile-starts')->assertSuccessful();
+
+        $this->assertSame('review', $txn->fresh()->status);
+        $this->assertSame('no_ack_from_device', $txn->fresh()->meta['review_reason']);
+        Http::assertSent(fn ($r) => str_contains($r['text'], $txn->order_id));
+    }
+
+    public function test_old_activated_rows_without_tracking_are_left_alone(): void
+    {
+        $legacy = DeviceTransaction::create([
+            'customer_id' => $this->customer->id, 'device_outlet_id' => $this->deviceOutletId,
+            'amount' => '5.00', 'currency' => 'MYR', 'status' => 'activated', 'provider' => 'fiuu',
+            'order_id' => 'ORD-M-LEGACY', 'meta' => ['op_id' => 'x'],
+        ]);
+
+        $this->artisan('app:reconcile-starts')->assertSuccessful();
+
+        $this->assertSame('activated', $legacy->fresh()->status);
+        Http::assertNothingSent();
+    }
+
+    public function test_customer_page_shows_duplicate_ignored_as_completed(): void
+    {
+        $txn = $this->activatedStart(5);
+        Redis::setex("start_ack:{$txn->meta['op_id']}", 60, json_encode(['status' => 'duplicate_ignored']));
+
+        $this->getJson("/payment/{$txn->id}/ack-status")->assertJson(['status' => 'completed']);
+    }
+}
diff --git b/tests/Feature/PaymentSecurityTest.php b/tests/Feature/PaymentSecurityTest.php
new file mode 100644
index 0000000..6849e3a
--- /dev/null
+++ b/tests/Feature/PaymentSecurityTest.php
@@ -0,0 +1,222 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Jobs\SendMqttCommand;
+use App\Models\DeviceTransaction;
+use App\Models\EwalletAccount;
+use App\Models\EwalletTransaction;
+use App\Models\PaymentGatewayTransaction;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Queue;
+
+/**
+ * Covers fixes F1–F4 from the 2026-10-14 review:
+ *  F1 no auto-login on return URLs, unguessable order ids, protected result pages
+ *  F2 duplicate Fiuu callbacks never start the machine twice
+ *  F3 duplicate top-up callbacks never credit twice
+ *  F4 e-wallet spend is locked, ledgered, uses bonus, and blocks double taps
+ */
+class PaymentSecurityTest extends PaymentTestCase
+{
+    // ───────────────────────── F2: device callbacks ─────────────────────────
+
+    public function test_duplicate_device_callbacks_start_the_machine_only_once(): void
+    {
+        $txn = $this->deviceOrder(customerId: $this->customer->id);
+        $payload = $this->fiuu($txn->order_id, '5.00');
+
+        $this->post('/guest/payment/callback', $payload)->assertOk()->assertSee('CBTOKEN:MPSTATOK');
+        $this->post('/guest/payment/callback', $payload)->assertOk()->assertSee('CBTOKEN:MPSTATOK');
+        $this->post('/customer/customer/payment/callback', $payload)->assertOk();
+
+        Queue::assertPushed(SendMqttCommand::class, 1);
+        Queue::assertPushed(SendMqttCommand::class, fn ($job) => $job->payload['pulses'] === 5
+            && $job->payload['op_id'] === $txn->fresh()->meta['op_id']);
+        $this->assertSame('activated', $txn->fresh()->status);
+    }
+
+    public function test_invalid_signature_is_rejected_and_changes_nothing(): void
+    {
+        $txn = $this->deviceOrder();
+        $payload = $this->fiuu($txn->order_id, '5.00');
+        $payload['skey'] = str_repeat('0', 32);
+
+        $this->post('/guest/payment/callback', $payload)->assertStatus(400);
+
+        Queue::assertNothingPushed();
+        $this->assertSame('initiated', $txn->fresh()->status);
+    }
+
+    public function test_amount_mismatch_does_not_start_machine(): void
+    {
+        $txn = $this->deviceOrder(amount: '5.00');
+
+        $this->post('/guest/payment/callback', $this->fiuu($txn->order_id, '1.00'))->assertOk();
+
+        Queue::assertNothingPushed();
+        $this->assertSame('review', $txn->fresh()->status);
+    }
+
+    public function test_late_failure_notice_does_not_overwrite_success(): void
+    {
+        $txn = $this->deviceOrder();
+        $this->post('/guest/payment/callback', $this->fiuu($txn->order_id, '5.00'))->assertOk();
+        $this->post('/guest/payment/callback', $this->fiuu($txn->order_id, '5.00', '11'))->assertOk();
+
+        $this->assertSame('activated', $txn->fresh()->status);
+    }
+
+    // ───────────────────────── F1: return URLs / pages ─────────────────────────
+
+    public function test_return_url_never_logs_anyone_in(): void
+    {
+        $txn = $this->deviceOrder(customerId: $this->customer->id);
+
+        // Attacker replays the return URL with only an order id.
+        $res = $this->get('/customer/customer/payment/return?orderid=' . $txn->order_id . '&status=00');
+
+        $this->assertGuest('customer');
+        Queue::assertNothingPushed(); // no valid signature -> nothing settled
+        $this->assertSame('initiated', $txn->fresh()->status);
+        $res->assertRedirect();
+    }
+
+    public function test_valid_return_settles_and_redirects_to_a_signed_page(): void
+    {
+        $txn = $this->deviceOrder();
+
+        $res = $this->post('/guest/payment/return', $this->fiuu($txn->order_id, '5.00'));
+        $res->assertRedirectContains('/device/' . $txn->id . '/start?expires=');
+
+        $this->get($res->headers->get('Location'))->assertOk();
+        Queue::assertPushed(SendMqttCommand::class, 1);
+
+        // Callback arriving after the return must not start it again.
+        $this->post('/guest/payment/callback', $this->fiuu($txn->order_id, '5.00'))->assertOk();
+        Queue::assertPushed(SendMqttCommand::class, 1);
+    }
+
+    public function test_result_pages_are_not_browsable_by_id(): void
+    {
+        $txn = $this->deviceOrder(customerId: $this->customer->id);
+        $mallory = $this->makeCustomer('mallory');
+
+        $this->get("/device/{$txn->id}/start")->assertForbidden();               // guest page, no signature
+        $this->get("/customer/customer/device/{$txn->id}/start")->assertRedirect();         // not logged in -> login
+        $this->actingAs($mallory, 'customer')->get("/customer/customer/device/{$txn->id}/start")->assertForbidden();
+        $this->actingAs($this->customer, 'customer')->get("/customer/customer/device/{$txn->id}/start")->assertOk();
+    }
+
+    public function test_order_ids_are_unguessable_and_unique(): void
+    {
+        $a = \App\Support\OrderId::make('M');
+        $b = \App\Support\OrderId::make('M');
+
+        $this->assertNotSame($a, $b);
+        $this->assertMatchesRegularExpression('/^ORD-M-[0-9A-HJKMNP-TV-Z]{26}$/', $a);
+    }
+
+    // ───────────────────────── F3: top-ups ─────────────────────────
+
+    private function topupOrder(string $amount = '10.00'): PaymentGatewayTransaction
+    {
+        return PaymentGatewayTransaction::create([
+            'user_id' => $this->customer->id, 'amount' => $amount, 'currency' => 'MYR',
+            'status' => 'initiated', 'provider' => 'fiuu', 'order_id' => 'ORD-T-TEST1',
+        ]);
+    }
+
+    public function test_duplicate_topup_callbacks_credit_only_once_including_bonus(): void
+    {
+        DB::table('topup_packages')->insert(['topup_amount' => 10.00, 'bonus_amount' => 2.00, 'is_active' => 1]);
+        $pg = $this->topupOrder('10.00');
+        $payload = $this->fiuu($pg->order_id, '10.00');
+
+        $this->post('/customer/gateway/callback', $payload)->assertOk();
+        $this->post('/customer/gateway/callback', $payload)->assertOk();
+        $this->post('/customer/gateway/return', $payload)->assertRedirect();
+
+        $acct = EwalletAccount::where('user_id', $this->customer->id)->first();
+        $this->assertEquals('10.00', $acct->credit_balance);
+        $this->assertEquals('2.00', $acct->bonus_balance);
+        $this->assertSame(1, EwalletTransaction::where('reference', $pg->order_id)->count());
+        $this->assertSame('paid', $pg->fresh()->status);
+    }
+
+    public function test_forged_topup_callback_cannot_fail_a_pending_topup(): void
+    {
+        $pg = $this->topupOrder();
+        $payload = $this->fiuu($pg->order_id, '10.00', '11');
+        $payload['skey'] = 'forged';
+
+        $this->post('/customer/gateway/callback', $payload)->assertStatus(400);
+        $this->assertSame('initiated', $pg->fresh()->status);
+    }
+
+    public function test_topup_return_does_not_log_in(): void
+    {
+        $pg = $this->topupOrder();
+        $this->get('/customer/gateway/return?orderid=' . $pg->order_id);
+        $this->assertGuest('customer');
+    }
+
+    // ───────────────────────── F4: e-wallet spend ─────────────────────────
+
+    public function test_wallet_payment_uses_credit_then_bonus_and_writes_ledger(): void
+    {
+        $this->wallet('3.00', '4.00');
+
+        $this->actingAs($this->customer, 'customer')
+            ->post('/customer/customer/payment/ewallet', ['device_outlet_id' => $this->deviceOutletId, 'mode' => 'washer_cold'])
+            ->assertRedirect();
+
+        $acct = EwalletAccount::where('user_id', $this->customer->id)->first();
+        $this->assertEquals('0.00', $acct->credit_balance);
+        $this->assertEquals('2.00', $acct->bonus_balance);
+
+        $ledger = EwalletTransaction::where('transaction_type', 'deduction')->sole();
+        $this->assertEquals('5.00', $ledger->amount);
+        $this->assertEquals('3.00', $ledger->deduct_amount);
+        $this->assertEquals('2.00', $ledger->deduct_bonus);
+        $this->assertEquals('2.00', $ledger->remaining_balance);
+
+        $txn = DeviceTransaction::where('provider', 'ewallet')->sole();
+        $this->assertSame($ledger->reference, $txn->order_id);
+        $this->assertSame('activated', $txn->status);
+        Queue::assertPushed(SendMqttCommand::class, 1);
+    }
+
+    public function test_wallet_insufficient_balance_charges_nothing(): void
+    {
+        $this->wallet('2.00', '1.00');
+
+        $this->actingAs($this->customer, 'customer')
+            ->from('/customer/customer/devices')
+            ->post('/customer/customer/payment/ewallet', ['device_outlet_id' => $this->deviceOutletId, 'mode' => 'washer_cold'])
+            ->assertSessionHas('error', 'Insufficient wallet balance.');
+
+        $this->assertEquals('2.00', EwalletAccount::first()->credit_balance);
+        $this->assertSame(0, DeviceTransaction::count());
+        Queue::assertNothingPushed();
+    }
+
+    public function test_wallet_double_tap_charges_once(): void
+    {
+        $this->wallet('20.00');
+        $body = ['device_outlet_id' => $this->deviceOutletId, 'mode' => 'washer_cold'];
+
+        $this->actingAs($this->customer, 'customer')->post('/customer/customer/payment/ewallet', $body);
+        $this->actingAs($this->customer, 'customer')->post('/customer/customer/payment/ewallet', $body);
+
+        $this->assertEquals('15.00', EwalletAccount::first()->credit_balance);
+        $this->assertSame(1, DeviceTransaction::count());
+        Queue::assertPushed(SendMqttCommand::class, 1);
+    }
+
+    public function test_wallet_payment_requires_login(): void
+    {
+        $this->post('/guest/payment/ewallet', ['device_outlet_id' => $this->deviceOutletId, 'mode' => 'washer_cold'])
+            ->assertRedirect(route('customer.login'));
+    }
+}
diff --git b/tests/Feature/PaymentTestCase.php b/tests/Feature/PaymentTestCase.php
new file mode 100644
index 0000000..0be3c5b
--- /dev/null
+++ b/tests/Feature/PaymentTestCase.php
@@ -0,0 +1,116 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Jobs\SendMqttCommand;
+use App\Models\Customer;
+use App\Models\DeviceTransaction;
+use App\Models\EwalletAccount;
+use App\Models\EwalletTransaction;
+use App\Models\PaymentGatewaySetting;
+use App\Models\PaymentGatewayTransaction;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Queue;
+use Illuminate\Support\Facades\Redis;
+use Tests\TestCase;
+
+/**
+ * Shared fixture for payment tests: one outlet, device TESTSN0001
+ * (washer RM5/6/7, pulse_price RM1), online in Redis, customer "alice",
+ * an active Fiuu gateway (secret SECRET, verify key VERIFY).
+ *
+ * (Originally the top of PaymentSecurityTest, which covers fixes F1–F4 from the 2026-10-14 review:
+ *  F1 no auto-login on return URLs, unguessable order ids, protected result pages
+ *  F2 duplicate Fiuu callbacks never start the machine twice
+ *  F3 duplicate top-up callbacks never credit twice
+ *  F4 e-wallet spend is locked, ledgered, uses bonus, and blocks double taps
+ */
+abstract class PaymentTestCase extends TestCase
+{
+    use RefreshDatabase;
+
+    protected PaymentGatewaySetting $gw;
+    protected Customer $customer;
+    protected int $deviceOutletId;
+    protected string $serial = 'TESTSN0001';
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+        Queue::fake();
+
+        $this->gw = PaymentGatewaySetting::forceCreate([
+            'merchant_id' => 'merchant_x', 'terminal_id' => 't1',
+            'secret_key' => 'SECRET', 'private_key' => 'VERIFY', 'status' => 'active',
+        ]);
+
+        $this->customer = $this->makeCustomer('alice');
+
+        $now = now();
+        $managerId  = DB::table('managers')->insertGetId(['name' => 'M', 'created_at' => $now, 'updated_at' => $now]);
+        $brandId    = DB::table('brands')->insertGetId(['name' => 'B', 'created_at' => $now, 'updated_at' => $now]);
+        $statusId   = DB::table('type_statuses')->insertGetId(['name' => 'Active', 'created_at' => $now, 'updated_at' => $now]);
+        $typeId     = DB::table('type_outlets')->insertGetId(['name' => 'Laundry', 'created_at' => $now, 'updated_at' => $now]);
+        $supplierId = DB::table('suppliers')->insertGetId(['supplier_name' => 'S', 'created_at' => $now, 'updated_at' => $now]);
+        $outletId   = DB::table('outlets')->insertGetId([
+            'outlet_name' => 'Outlet 1', 'manager_id' => $managerId, 'brand_id' => $brandId,
+            'status_id' => $statusId, 'type_id' => $typeId, 'created_at' => $now, 'updated_at' => $now,
+        ]);
+        DB::table('devices')->insert([
+            'serial_number' => $this->serial, 'model' => 'LBP', 'supplier_id' => $supplierId,
+            'washer_cold_price' => 5.00, 'washer_warm_price' => 6.00, 'washer_hot_price' => 7.00,
+            'pulse_price' => 1.00, 'pulse_width' => 100, 'pulse_delay' => 100,
+            'created_at' => $now, 'updated_at' => $now,
+        ]);
+        $this->deviceOutletId = DB::table('device_has_outlet')->insertGetId([
+            'outlet_id' => $outletId, 'machine_num' => '1', 'machine_name' => 'W1', 'machine_type' => 'Washer',
+            'device_serial_number' => $this->serial, 'status' => 'Online', 'created_at' => $now, 'updated_at' => $now,
+        ]);
+
+        Redis::setex("machine:status:{$this->serial}", 600, 'online');
+    }
+
+    protected function tearDown(): void
+    {
+        Redis::del("machine:status:{$this->serial}");
+        parent::tearDown();
+    }
+
+    // ───────────────────────── helpers ─────────────────────────
+
+    protected function makeCustomer(string $name): Customer
+    {
+        return Customer::forceCreate([
+            'name' => $name, 'email' => "$name@example.com", 'username' => $name,
+            'password' => bcrypt('secret'), 'referral_code' => strtoupper($name),
+        ]);
+    }
+
+    /** A Fiuu result payload with a correct skey. */
+    protected function fiuu(string $orderId, string $amount, string $status = '00', string $tranId = 'T123'): array
+    {
+        $p = [
+            'tranID' => $tranId, 'orderid' => $orderId, 'status' => $status, 'domain' => 'merchant_x',
+            'amount' => $amount, 'currency' => 'MYR', 'appcode' => 'A1', 'paydate' => '2026-10-14 21:00:00',
+            'nbcb' => '1',
+        ];
+        $key0 = md5($p['tranID'] . $p['orderid'] . $p['status'] . $p['domain'] . $p['amount'] . $p['currency']);
+        $p['skey'] = md5($p['paydate'] . $p['domain'] . $key0 . $p['appcode'] . 'SECRET');
+        return $p;
+    }
+
+    protected function deviceOrder(string $orderId = 'ORD-M-TEST1', ?int $customerId = null, string $amount = '5.00'): DeviceTransaction
+    {
+        return DeviceTransaction::create([
+            'customer_id' => $customerId, 'device_outlet_id' => $this->deviceOutletId,
+            'amount' => $amount, 'currency' => 'MYR', 'status' => 'initiated', 'provider' => 'fiuu',
+            'order_id' => $orderId, 'meta' => ['type' => 'device', 'mode' => 'washer_cold'],
+        ]);
+    }
+
+    protected function wallet(string $credit, string $bonus = '0'): EwalletAccount
+    {
+        return EwalletAccount::create(['user_id' => $this->customer->id, 'credit_balance' => $credit, 'bonus_balance' => $bonus]);
+    }
+}
diff --git b/tests/Feature/PulseLimitTest.php b/tests/Feature/PulseLimitTest.php
new file mode 100644
index 0000000..ea79e8b
--- /dev/null
+++ b/tests/Feature/PulseLimitTest.php
@@ -0,0 +1,110 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Jobs\SendMqttCommand;
+use App\Models\Device;
+use App\Models\DeviceTransaction;
+use App\Models\EwalletAccount;
+use App\Models\User;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Queue;
+use PhpMqtt\Client\Facades\MQTT;
+use Spatie\Permission\Models\Permission;
+
+/**
+ * Bug 2026-10-16: RM1.00 credited 100 pulses but RM2.00 credited nothing
+ * extra. pulse_price RM0.01 -> RM2.00 = 200 pulses, and firmware <= v1.5.4
+ * rejected anything over a hard-coded 100 ("too_many_pulses").
+ * The backend now owns the limit (config lbpay.max_pulses_per_start),
+ * pushes it to the device in CONFIG, and refuses BEFORE charging.
+ *
+ * Reuses the PaymentTestCase fixture (outlet, device TESTSN0001,
+ * washer_cold RM5, customer alice).
+ */
+class PulseLimitTest extends PaymentTestCase
+{
+    private function setPulsePrice(string $pulsePrice, array $extra = []): void
+    {
+        DB::table('devices')->where('serial_number', 'TESTSN0001')
+            ->update(array_merge(['pulse_price' => $pulsePrice], $extra));
+    }
+
+    private function technician(): User
+    {
+        foreach (['devices_outlet.manage', 'devices_outlet.edit', 'outlets.view-all'] as $p) {
+            Permission::findOrCreate($p, 'web');
+        }
+        $u = User::forceCreate(['name' => 'Tech', 'email' => 'tech@example.com', 'password' => bcrypt('x')]);
+        $u->givePermissionTo(['devices_outlet.manage', 'devices_outlet.edit', 'outlets.view-all']);
+        return $u;
+    }
+
+    public function test_rm2_at_one_sen_per_pulse_is_exactly_200_pulses(): void
+    {
+        $this->setPulsePrice('0.01');
+        $device = Device::where('serial_number', 'TESTSN0001')->first();
+
+        $this->assertSame(100, $device->pulsesFor(1.00));
+        $this->assertSame(200, $device->pulsesFor(2.00));
+        $this->assertSame(570, $device->pulsesFor(5.70)); // float noise would give 571
+    }
+
+    public function test_technician_start_rm2_sends_200_pulses(): void
+    {
+        $this->setPulsePrice('0.01');
+
+        $this->actingAs($this->technician(), 'sanctum')
+            ->postJson('/api/technician/devices/TESTSN0001/start', ['type' => 'custom', 'price' => 2.00])
+            ->assertOk()->assertJson(['pulses' => 200]);
+
+        Queue::assertPushed(SendMqttCommand::class, fn ($j) => $j->action === 'REMOTE_START' && $j->payload['pulses'] === 200);
+    }
+
+    public function test_technician_start_over_limit_is_refused_with_clear_message(): void
+    {
+        config(['lbpay.max_pulses_per_start' => 100]); // e.g. fleet still on v1.5.4
+        $this->setPulsePrice('0.01');
+
+        $this->actingAs($this->technician(), 'sanctum')
+            ->postJson('/api/technician/devices/TESTSN0001/start', ['type' => 'custom', 'price' => 2.00])
+            ->assertStatus(422)->assertJsonFragment(['message' => 'RM2.00 needs 200 pulses; the controller accepts at most 100 per start.']);
+
+        Queue::assertNothingPushed();
+    }
+
+    public function test_customer_is_not_charged_when_price_exceeds_limit(): void
+    {
+        config(['lbpay.max_pulses_per_start' => 100]);
+        $this->setPulsePrice('0.01'); // washer_cold RM5 = 500 pulses > 100
+        EwalletAccount::create(['user_id' => \App\Models\Customer::first()->id, 'credit_balance' => '20.00', 'bonus_balance' => 0]);
+
+        $this->actingAs(\App\Models\Customer::first(), 'customer')
+            ->post('/customer/customer/payment/ewallet', ['device_outlet_id' => DB::table('device_has_outlet')->value('id'), 'mode' => 'washer_cold'])
+            ->assertStatus(422);
+
+        $this->assertEquals('20.00', EwalletAccount::first()->credit_balance);
+        $this->assertSame(0, DeviceTransaction::count());
+        Queue::assertNothingPushed();
+    }
+
+    public function test_saving_parameters_that_exceed_limit_is_rejected(): void
+    {
+        config(['lbpay.max_pulses_per_start' => 100]);
+
+        $this->actingAs($this->technician(), 'sanctum')
+            ->putJson('/api/technician/devices/TESTSN0001/parameters', ['pulse_price' => 0.01, 'washer_cold_price' => 2.00])
+            ->assertStatus(422)->assertJsonValidationErrors('pulse_price');
+    }
+
+    public function test_config_push_tells_the_device_its_limit(): void
+    {
+        config(['lbpay.max_pulses_per_start' => 1000]);
+        MQTT::shouldReceive('publish')->once()->withArgs(function ($topic, $message, $retain) {
+            $p = json_decode($message, true);
+            return $topic === 'machines/TESTSN0001/cmd' && $p['action'] === 'CONFIG' && $p['max_pulses'] === 1000 && $retain === true;
+        });
+
+        (new SendMqttCommand('TESTSN0001', 'CONFIG'))->handle();
+    }
+}
